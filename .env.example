# Supabase Postgres connection string
# Get this from Supabase → Settings → Database → Connection String → URI
# Replace [YOUR-PASSWORD] with your actual database password (URL-encode @ as %40)
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# Direct connection (used by prisma/seed.ts and prisma db push).
# Falls back to DATABASE_URL if not set. Usually the same as DATABASE_URL for Supabase.
DIRECT_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# Required by NextAuth (legacy, not used by current cookie auth but kept for compatibility)
AUTH_SECRET="any-random-string-32-chars-minimum"
