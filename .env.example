# Supabase Postgres connection string — use the POOLER URL (not direct URL).
# Get this from Supabase → Settings → Database → Connection String → Session pooler
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# IMPORTANT: URL-encode special chars in the password (@ → %40, # → %23)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Direct connection — usually the same as DATABASE_URL for Supabase pooler
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Random secret for cookie session signing (any 32+ char string)
AUTH_SECRET="any-random-string-32-chars-minimum"

# Browser-side Supabase URL + anon key (needed for Realtime subscriptions).
# Must be NEXT_PUBLIC_-prefixed so Next.js exposes them to the browser.
# Get from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Server-side service role key (used by seed scripts — NOT exposed to browser)
# Get from Supabase → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"
