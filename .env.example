# Supabase Postgres connection string (server-side only — used by Prisma)
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# Direct connection (used by prisma/seed.ts and prisma db push).
DIRECT_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# Random secret for cookie session signing
AUTH_SECRET="any-random-string-32-chars-minimum"

# Browser-side Supabase URL + anon key — needed for Realtime subscriptions.
# The anon key is safe to expose (RLS protects the data). Must be prefixed
# with NEXT_PUBLIC_ so Next.js exposes them to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key"
